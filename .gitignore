# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/artifacts
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

.venv
fixtures/generated
fixtures/v1-goldens/filed/*
!fixtures/v1-goldens/filed/.gitkeep
lab-output/
__pycache__/
.pytest_cache/
*.pyc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- added for AI loop safety (real client files must never be committed) ---
# Real reference outputs: only anonymised copies may be committed (force-add after review).
docs/reference/outputs/*
!docs/reference/outputs/.gitkeep
# Local verification logs
/.verify-*.log
# AI orchestration run packages
/.ai/runs/
/.ai/STOP
/.ai/PAUSE
/.ai/state.json
/.ai/*.txt
